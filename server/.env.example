# castel Backend — Beispielkonfiguration.
# Datei kopieren zu .env, eigene Werte setzen, NICHT einchecken.

# PostgreSQL-Verbindung
DATABASE_URL=postgres://castel:castel-dev@localhost:5432/castel
# Prevent a stuck query or idle transaction from blocking sync forever.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Slow/half-open client connections are closed after this limit.
HTTP_CONNECTION_TIMEOUT_MS=65000

# Auth
# JWT_SECRET: 32+ zufällige Bytes, z. B. `openssl rand -hex 32`
JWT_SECRET=bitte-ersetzen-mit-32-zufalls-bytes-hex-kodiert
JWT_EXPIRES_IN=12h
# Refresh-Token-Cookie
COOKIE_SECURE=false       # in Dev: false (HTTP), in Prod über Cloudflare-Tunnel: true
COOKIE_DOMAIN=localhost

# Bootstrap-Admin (nur fürs erste Setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-ersetzen-mit-starkem-passwort

# CORS
CORS_ORIGIN=http://localhost:5173

# Foto-Speicher
FOTOS_DIR=./var/fotos
FOTOS_MAX_BYTES=524288    # 512 kB pro Datei serverseitig
FOTOS_MAX_PER_ARTIKEL=5

# Rate-Limit (Login)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=1 minute

# ---------- Agenten-API / MCP ----------
# API-Keys werden in der PWA unter Einstellungen -> Daten -> API-Keys
# verwaltet. Der Server speichert nur SHA-256-Hash + Prefix.
API_KEYS_ENABLED=true
API_KEY_MAX_PER_USER=10
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=1 minute
MCP_ENABLED=true
MCP_PATH=/api/mcp
API_DOCS_ENABLED=true
