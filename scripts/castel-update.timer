[Unit]
Description=castel Update-Timer (prueft alle 15 Sekunden auf eine Update-Anforderung)

[Timer]
# Erst 20 Sekunden nach dem Boot, danach alle 15 Sekunden. Der Runner ist
# idempotent und beendet sich sofort, wenn keine Anforderung offen ist.
OnBootSec=20s
OnUnitActiveSec=15s
AccuracySec=1s
Unit=castel-update.service

[Install]
WantedBy=timers.target
