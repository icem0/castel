# castel — Production Environment
# Diese Datei kopieren nach `.env` und ausfüllen, NIE einchecken.
#
# Der Stack zieht api/pwa/migrate als fertige Images von
# GitHub Container Registry (`ghcr.io/icem0/castel-{api,pwa}:latest`,
# siehe docker-compose.yml). Der CI-Workflow baut und pusht sie bei
# jedem Push auf `main`. Für öffentliche Images ist kein Token nötig;
# für private Pakete siehe README → Deployment → GHCR-Token.
#
# Der allererste Admin-User wird per Setup-Formular in der PWA angelegt
# (Login-Seite), sobald die `users`-Tabelle leer ist. Es ist kein
# Bootstrap-Schritt aus der .env noetig.

# ---------- Ports am Host ----------
# Im Self-Hosting-Setup wird nur PWA_PORT am Host exponiert — nginx im
# PWA-Container proxied /api/* an den api-Service im internen Docker-
# Network (siehe docker-compose.yml + nginx-pwa.conf).
#
# API_PORT wird nur gebraucht, wenn der api-Service direkt am Host
# erreichbar sein soll (z. B. CLI-Tools, curl-Debug). Dazu in
# docker-compose.yml den auskommentierten 'ports:'Block beim api-Service
# wieder aktivieren.
PWA_PORT=4280
# API_PORT=4242

# ---------- PWA → API ----------
# Basis-URL, unter der die PWA das API-Backend erreichen kann. Wird beim
# Container-Start des pwa-Service in /config.js geschrieben und in der
# App als window.__CASTEL_API_URL__ ausgelesen (siehe scripts/pwa-entrypoint.sh
# und src/auth/api.ts).
#
# WICHTIG: Origin-Basis OHNE '/api'. Die App haengt '/api/...' selbst an
# die Basis an — wer '/api' mit in VITE_API_URL packt, kassiert 404
# unter '/api/api/...'. src/auth/api.ts schneidet ein trailing '/api'
# automatisch ab, aber sauberer ist die Origin-Basis.
#
# Leer / ungesetzt (Empfehlung im Self-Host mit nginx-PWA-Container):
# gleicher Origin, /api/* wird von nginx im PWA-Container an die API
# proxied. Nur EIN Host-Port noetig.
#
# Beispiele:
#   Empfehlung (Reverse-Proxy mappt /api/*, leer lassen):
#     # VITE_API_URL=
#   API hinter Reverse-Proxy, eigene Domain:
#     VITE_API_URL=https://api.example.com
#   LAN-Direktzugriff (API_PORT am Host exposed):
#     VITE_API_URL=http://192.168.1.10:4242
# VITE_API_URL=

# ---------- Datenbank ----------
DB_NAME=castel
DB_USER=castel
# Starkes Passwort, mind. 16 Zeichen, generiert z. B. mit `openssl rand -base64 24`
DB_PASSWORD=

# ---------- Auth ----------
# JWT_SECRET: mindestens 64 Zeichen, z. B. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Der allererste Admin-User wird beim ersten Aufruf der Login-Seite direkt in
# der PWA angelegt (Setup-Formular: Anzeigename + E-Mail + Passwort). Es ist
# kein Bootstrap-User aus der .env noetig.

# Cookie-Domain — Domain, unter der die PWA tatsächlich läuft (OHNE Protokoll).
# Bei lokalem Test ohne Domain: COOKIE_DOMAIN=localhost
COOKIE_DOMAIN=localhost

# CORS-Origin der PWA (WO der Browser tatsächlich läuft)
# Lokal: CORS_ORIGIN=http://localhost:4280
# Hinter eigenem Reverse-Proxy: CORS_ORIGIN=https://deine-domain.example
CORS_ORIGIN=http://localhost:4280

# Setze COOKIE_SECURE=true wenn die PWA über HTTPS erreichbar ist
# (setzt das Secure-Flag auf dem Refresh-Cookie).
COOKIE_SECURE=false

# ---------- Foto-Limits ----------
FOTOS_MAX_BYTES=524288       # 512 kB pro Datei
FOTOS_MAX_PER_ARTIKEL=5

# ---------- Rate-Limit ----------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=1 minute

# ---------- Logging ----------
# LOG_LEVEL steuert den Fastify-Logger der API (Werte: trace|debug|info|warn|error).
# PG_LOG_LEVEL ist optional und ueberschreibt das abgeleitete Postgres-Loglevel
# (Postgres-GUC log_min_messages, Werte: debug5|debug4|debug3|debug2|debug1|
# debug|info|notice|warning|error|log|fatal|panic).
# Mapping, wenn PG_LOG_LEVEL leer ist:
#   trace -> debug2, debug -> debug1, info -> info, warn -> warning, error -> error.
# Default ohne beide: warning (kein Statement-Log).
# ACHTUNG: Bei PG_LOG_LEVEL=debug*/info/notice schaltet der Stack zusaetzlich
# log_statement=all + log_duration=on ein -> JEDES SQL landet im Log. Nur
# kurzzeitig zum Debuggen setzen, danach auf warning zurueck.
LOG_LEVEL=info
# PG_LOG_LEVEL=warning

# ---------- Development Mode ----------
# Setzt das System in Development-Modus. Effekte:
#   - API exponeert /api/dev/status, das den Modus meldet.
#   - PWA zeigt im Login-Screen und im Header ein sichtbares Badge
#     "DEV MODE" (mit Tooltip, dass das ein .env-Flag ist).
# Werte: 'true' | 'false' (oder '1' | '0'). Default: false.
# Im Live-Betrieb: DEV_MODE=false (oder weglassen).
# Lokale Tests:  DEV_MODE=true.
# DEV_MODE=true

# ---------- Volumes / Persistenz ----------
# Der Stack nutzt zwei named Volumes für persistente Daten:
#   - pgdata       → PostgreSQL-Daten (Schema, User, Buchungen, Migrations)
#   - fotos-data   → Artikelbilder (FOTOS_DIR=/var/lib/castel/fotos)
#
# Standard: Docker legt die Volumes unter
#   /var/lib/docker/volumes/<projekt>_<name>/_data
# an. Das reicht für Persistenz. Backup via
#   docker run --rm -v <vol>:/data alpine tar czf - /data
# bzw. `pg_dump` (siehe README).
#
# Wenn du die Daten lieber auf einem bestimmten Host-Pfad liegen haben
# willst (Backup-Skripte, NFS, Syncthing, externe Platte), leg eine
# `docker-compose.override.yml` neben die `docker-compose.yml` an und
# referenziere die Variablen unten als bind-mounts. `docker compose up`
# zieht die override-Datei automatisch mit.
#
#   services:
#     db:
#       volumes:
#         - ${PGDATA_DIR}:/var/lib/postgresql/data
#     api:
#       volumes:
#         - ${FOTOS_DIR_HOST}:/var/lib/castel/fotos
#
# 1) PostgreSQL-Daten (DB-Cluster, WAL, Migrations, User-Tabellen)
#    Empfehlung: eigenes Verzeichnis, Eigentümer 999:999 (postgres).
#    Vor `up` einmal anlegen:
#      sudo mkdir -p /srv/castel/pgdata && \
#      sudo chown -R 999:999 /srv/castel/pgdata
PGDATA_DIR=/srv/castel/pgdata

# 2) Artikelbilder (FOTOS_DIR im API-Container: /var/lib/castel/fotos)
#    Empfehlung: gleicher Besitzer wie der API-User (uid 1001, siehe
#    server/Dockerfile). Vor `up`:
#      sudo mkdir -p /srv/castel/fotos && \
#      sudo chown -R 1001:1001 /srv/castel/fotos
FOTOS_DIR_HOST=/srv/castel/fotos

# 3) Optional: Config / Backups / TLS-Material
#    Wird NICHT automatisch gemountet — dient nur als Ablageort für
#    eigene Skripte (Backup-Cron, Restore, Config-Mgmt). Beispiele:
#      /srv/castel/config/nginx.conf   (eigener Reverse-Proxy)
#      /srv/castel/config/dump.sql     (pg_dump-Ziel)
CASTEL_CONFIG_DIR=/srv/castel/config